<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 Expressive UI - 4 Sekmeli Modern Yazdırma Kontrol Merkezi -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface">

    <!-- Material 3 Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleTextColor="@color/md_theme_onSurface"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:subtitle="@string/app_subtitle"
            app:subtitleTextColor="@color/md_theme_onSurfaceVariant"
            app:menu="@menu/menu_top_app_bar" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/mainProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminate="true"
            app:indicatorColor="@color/md_theme_primary"
            app:trackColor="@color/md_theme_surfaceVariant" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Ana İçerik Konteyneri (4 Sekme) -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- ==================== 1. SEKME: ANA SAYFA ==================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/tabHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <!-- Büyük Hero Durum Kartı -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:cardBackgroundColor="@color/md_theme_surfaceContainerLow">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvHomeModelTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Canon LBP2900"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/md_theme_onSurface" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipHomeStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/status_not_connected"
                                android:textColor="@color/badge_error_text"
                                app:chipBackgroundColor="@color/badge_error_bg"
                                app:chipStrokeWidth="0dp"
                                app:chipMinTouchTargetSize="0dp"
                                android:clickable="false"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvHomeDeviceDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/printer_searching"
                            android:textSize="13sp"
                            android:textColor="@color/md_theme_onSurfaceVariant" />

                        <!-- Ana Buton Grubu -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnHomeConnect"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                app:cornerRadius="14dp"
                                android:text="Yazıcıya Bağlan"
                                android:textSize="13sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnHomeQuickTest"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                app:cornerRadius="14dp"
                                android:text="Test Sayfası"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Android Sistem Yazdırma Servisi Durum Kartı -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardServiceContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:cardBackgroundColor="@color/md_theme_surfaceContainerLow">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/print_service_title"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/md_theme_onSurface" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipServiceStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sistem Servisi"
                                android:textColor="@color/badge_warn_text"
                                app:chipBackgroundColor="@color/badge_warn_bg"
                                app:chipStrokeWidth="0dp"
                                app:chipMinTouchTargetSize="0dp"
                                android:clickable="false"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvServiceExplanation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Chrome, Galeri, WhatsApp gibi uygulamalardan doğrudan 'Yazdır' menüsünü kullanabilmek için Android Yazdırma Servisi'ni etkinleştirin."
                            android:textSize="13sp"
                            android:textColor="@color/md_theme_onSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenServiceSettings"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            app:cornerRadius="14dp"
                            android:text="Yazdırma Servisini Aç / Yapılandır"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Nasıl Kullanılır / Rehber Kartı -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:cardBackgroundColor="@color/md_theme_surfaceContainerLow">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡 Hızlı Başlangıç İpuçları"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="4dp"
                            android:text="1. OTG adaptörünü telefona, USB kablosunu Canon yazıcıya bağlayın.\n2. Yazıcının güç düğmesine basıp hazır konuma getirin.\n3. 'Yazdır' sekmesine geçip dilediğiniz PDF veya fotoğrafı seçin.\n4. Ayrıca herhangi bir uygulamada 'Paylaş > CAPT Print' yaparak hızlıca yazdırabilirsiniz."
                            android:textSize="13sp"
                            android:textColor="@color/md_theme_onSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ==================== 2. SEKME: YAZDIR ==================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/tabPrint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <!-- Büyük Dosya Seçim Alanı -->
                <FrameLayout
                    android:id="@+id/btnUploadArea"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="@drawable/bg_upload_box"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_file"
                            app:tint="@color/md_theme_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Belge veya Resim Seçmek İçin Dokunun"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="PDF, JPEG, PNG, WebP desteklenir"
                            android:textSize="12sp"
                            android:textColor="@color/md_theme_onSurfaceVariant" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Seçili Dosya Kartı (Dinamik) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSelectedFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:cardBackgroundColor="@color/md_theme_tertiaryContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_file"
                            app:tint="@color/md_theme_onTertiaryContainer" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSelectedFileName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="belge.pdf"
                                android:textColor="@color/md_theme_onTertiaryContainer"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/tvSelectedFileInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Yazdırılmaya Hazır"
                                android:textColor="@color/md_theme_onTertiaryContainer"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRemoveSelectedFile"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cancel"
                            android:textColor="@color/md_theme_error" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Yazdırma Parametreleri Kartı -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:cardBackgroundColor="@color/md_theme_surfaceContainerLow">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚙️ Yazdırma Ayarları"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface" />

                        <!-- Kopya Sayısı Stepper -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Kopya Sayısı"
                                android:textSize="14sp"
                                android:textColor="@color/md_theme_onSurface" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCopiesMinus"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:icon="@drawable/ic_remove"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:cornerRadius="12dp" />

                            <TextView
                                android:id="@+id/tvCopiesCount"
                                android:layout_width="48dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="1"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/md_theme_onSurface" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCopiesPlus"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:icon="@drawable/ic_add"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:cornerRadius="12dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="14dp"
                            android:background="@color/md_theme_outlineVariant" />

                        <!-- Toner Yoğunluğu Seçici (Chips) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Toner Yoğunluğu"
                            android:textSize="14sp"
                            android:textColor="@color/md_theme_onSurface" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupToner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipTonerEconomy"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tasarruf" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipTonerNormal"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Normal" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipTonerDark"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Koyu (Önerilen)" />
                        </com.google.android.material.chip.ChipGroup>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="14dp"
                            android:background="@color/md_theme_outlineVariant" />

                        <!-- Ters Renk (Invert) Switch -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Renkleri Ters Çevir (Invert)"
                                    android:textSize="14sp"
                                    android:textColor="@color/md_theme_onSurface" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Siyah/beyaz polariteyi tersine çevirir"
                                    android:textSize="12sp"
                                    android:textColor="@color/md_theme_onSurfaceVariant" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchInvert"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Canlı İlerleme Durumu -->
                <TextView
                    android:id="@+id/tvPrintProgressStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text=""
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_primary"
                    android:visibility="gone" />

                <!-- Büyük Yazdır Butonları -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSystemPrint"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_print"
                    app:iconGravity="textStart"
                    android:text="🖨️ Android Sistem Yazdırma Ekranı"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDirectPrint"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    app:cornerRadius="14dp"
                    android:text="⚡ Hızlı Doğrudan Yazdır (USB)"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ==================== 3. SEKME: AYARLAR ==================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/tabSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:cardBackgroundColor="@color/md_theme_surfaceContainerLow">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🖨️ Yazdırma Servisi Yapılandırması"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Android yazdırma alt yapısında 'Canon LBP' servisini yönetin."
                            android:textSize="13sp"
                            android:textColor="@color/md_theme_onSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSettingsOpenPrintSpooler"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            app:cornerRadius="14dp"
                            android:text="Android Yazdırma Servislerini Yönet"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSettingsRequestUsbPermission"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            app:cornerRadius="14dp"
                            android:text="USB Yetkilendirme İznini Yenile"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Desteklenen Modeller Kartı -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:cardBackgroundColor="@color/md_theme_surfaceContainerLow">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📋 Desteklenen Donanımlar"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:text="• Canon Laser Shot LBP2900 (0x04A9:0x2676)\n• Canon Laser Shot LBP3000 (0x04A9:0x26B0)\n• Canon LBP3100 (0x04A9:0x26CE)\n• Canon LBP6000 (0x04A9:0x271A)\n• Genel USB Printer Sınıf 7 Aygıtları"
                            android:textSize="13sp"
                            android:textColor="@color/md_theme_onSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Hakkında Kartı -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:cardBackgroundColor="@color/md_theme_surfaceContainerLow">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ℹ️ Sürücü Hakkında"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:text="CAPT Print, Canon'un tescilli HiSCoA ve CAPT protokolü için geliştirilmiş açık kaynaklı Android USB Host sürücüsüdür.\n\nSürüm: 1.0 (NDK C11 + Floyd-Steinberg Dither Motoru)"
                            android:textSize="13sp"
                            android:textColor="@color/md_theme_onSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ==================== 4. SEKME: KONSOL / TANILAMA ==================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/tabConsole"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <!-- Konsol Eylem Çubuğu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConsoleQueryStatus"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        app:cornerRadius="12dp"
                        android:text="Durum Sorgula"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConsoleListDevices"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        app:cornerRadius="12dp"
                        android:text="USB Cihazları"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Terminal Penceresi -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/md_theme_outlineVariant"
                    app:cardBackgroundColor="@color/terminal_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <!-- Konsol Üst Şeridi -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@color/terminal_header"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="CAPT Sürücü Konsolu"
                                android:textColor="#A0AEC0"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnConsoleClear"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="@string/clear"
                                android:textColor="#CBD5E0"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btnConsoleCopy"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="@string/copy"
                                android:textColor="#CBD5E0"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ScrollView
                            android:id="@+id/scrollViewConsole"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tvConsoleLog"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textColor="@color/terminal_text"
                                android:textSize="11sp"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/console_initial" />
                        </ScrollView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

    <!-- Material 3 Bottom Navigation Bar (Tab Bar) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/md_theme_surface"
        app:elevation="8dp"
        app:itemIconTint="@color/md_theme_primary"
        app:itemTextColor="@color/md_theme_onSurface"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
